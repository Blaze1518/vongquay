        "/whitelist-ips/": {
            "post": {
                "description": "Creates a unique IP or CIDR row in table whitelist_ips. Stored as PostgreSQL cidr: use a network prefix (e.g. 203.0.113.10/32 for a single IPv4 host, 2001:db8::/32 for an IPv6 range). Duplicate ip_address returns 409. is_active is stored as-is; access control must ignore rows with is_active=false.\nOn success the JSON envelope uses success/data; data is a WhitelistIP object (id, ip_address, description, is_active, created_at, updated_at).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "whitelist-ips"
                ],
                "summary": "Create whitelist IP",
                "operationId": "createWhitelistIP",
                "parameters": [
                    {
                        "description": "Create whitelist IP payload",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/whitelistip.CreateWhitelistIPRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created; data field contains WhitelistIP",
                        "schema": {
                            "$ref": "#/definitions/github_com_Blaze1518_sinhnhatf168_internal_errors.Response"
                        }
                    },
                    "400": {
                        "description": "Validation error (invalid JSON or binding rules)",
                        "schema": {
                            "$ref": "#/definitions/github_com_Blaze1518_sinhnhatf168_internal_errors.Response"
                        }
                    },
                    "409": {
                        "description": "Conflict — IP/CIDR already exists",
                        "schema": {
                            "$ref": "#/definitions/github_com_Blaze1518_sinhnhatf168_internal_errors.Response"
                        }
                    },
                    "500": {
                        "description": "Unexpected server error",
                        "schema": {
                            "$ref": "#/definitions/github_com_Blaze1518_sinhnhatf168_internal_errors.Response"
                        }
                    }
                }
            }
        }
