                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Winners"
                ],
                "summary": "Lấy danh sách người trúng giải (Có phân trang)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID của chiến dịch",
                        "name": "campaign_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "ID của giải thưởng",
                        "name": "prize_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Số trang hiện tại (Mặc định: 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Số lượng phần tử mỗi trang (Mặc định: 10)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Thành công",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/github_com_Blaze1518_sinhnhatf168_internal_errors.APIError"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/internal_game_winner.PaginatedResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Lỗi dữ liệu đầu vào",
                        "schema": {
                            "$ref": "#/definitions/github_com_Blaze1518_sinhnhatf168_internal_errors.APIError"
