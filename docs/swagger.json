                            "$ref": "#/definitions/internal_game_campaign.CreateCampaignRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Tạo chiến dịch thành công",
                        "schema": {
                            "$ref": "#/definitions/internal_game_campaign.Campaign"
                        }
                    },
                    "400": {
                        "description": "Dữ liệu gửi lên không hợp lệ hoặc sai định dạng JSON",
                        "schema": {
