                        }
                    }
                }
            }
        },
        "/game/winner": {
            "get": {
                "description": "Lấy danh sách lịch sử trúng thưởng dựa theo chiến dịch hoặc giải thưởng, hỗ trợ phân trang chuẩn hóa.",
