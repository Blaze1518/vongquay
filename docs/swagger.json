                    "example": "HQ VPN egress - INC-1234"
                },
                "ip_address": {
                    "type": "string",
                    "maxLength": 64,
                    "example": "203.0.113.10/32"
                },
                "is_active": {
                    "description": "IsActive when false, the entry is persisted but must not grant access (enforcement is middleware responsibility).",
                    "type": "boolean",
                    "example": true
                }
            }
        }
    }
}