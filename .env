# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
APP_NAME=sinhnhatf168
APP_VERSION=1.0.0
APP_ENVIRONMENT=production
APP_DEBUG=false
APP_PORT=8080

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DATABASE_HOST=postgres-db
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=sinhnhatf168
DATABASE_SSL_MODE=disable

# Biến khởi tạo Container Postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=sinhnhatf168

# Chuỗi kết nối đầy đủ (Phục vụ tool Migration nếu cần)
DB_URL=postgres://admin:your_password_here@postgres-db:5432/sinhnhatf168

# Tên Container phục vụ cho Docker Compose
DATABASE_CONTAINER_NAME=go_api_db

# ==============================================================================
# SECURITY & AUTHENTICATION (JWT)
# ==============================================================================
# Khóa bí mật dùng để ký token (Hãy đổi chuỗi này trên môi trường Production)
JWT_SECRET=super-secret-key-change-me-in-production
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# ==============================================================================
# LOGGING SYSTEM
# ==============================================================================
# Các mức log hợp lệ: debug, info, warn, error
LOGGING_LEVEL=info

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATELIMIT_ENABLED=true
RATELIMIT_REQUESTS=100
RATELIMIT_WINDOW=1m

# ==============================================================================
# DATABASE MIGRATIONS
# ==============================================================================
MIGRATIONS_DIRECTORY=migrations
MIGRATIONS_TIMEOUT=30
MIGRATIONS_LOCKTIMEOUT=10

# ==============================================================================
# DOCKER HEALTH CHECK CONFIGURATION
# ==============================================================================
HEALTH_CHECK_INTERVAL=15s
HEALTH_CHECK_TIMEOUT=5s
HEALTH_CHECK_RETRIES=5
HEALTH_CHECK_START_PERIOD=15s

# ==============================================================================
# PGADMIN (DATABASE GUI MANAGEMENT)
# ==============================================================================
PGADMIN_DEFAULT_EMAIL=blazer@attcloud.org
PGADMIN_DEFAULT_PASSWORD=blazer@attcloud.org
